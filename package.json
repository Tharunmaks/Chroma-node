{
  "name": "chroma-node",
  "version": "1.1.0",
  "description": "Self-hosted deploy platform with a 3D engine (124k procedural 3D/4D models), realtime database, sandboxed functions and live analytics — one Node.js package.",
  "type": "module",
  "main": "./server/index.js",
  "bin": {
    "chroma": "./bin/chroma.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "build:demo": "node scripts/export-static.mjs dist --base=/Chroma-node/"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "pyre-lang": "github:Tharunmaks/Pyre#claude/website-polish-3d-cmjt9f",
    "three": "0.170.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tharunmaks/Chroma-node.git"
  },
  "license": "MIT",
  "keywords": [
    "3d",
    "4d",
    "analytics",
    "deployment",
    "paas",
    "procedural-generation",
    "realtime-database",
    "self-hosted",
    "serverless",
    "shaders",
    "sqlite",
    "threejs",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://github.com/Tharunmaks/Chroma-node#readme"
}
